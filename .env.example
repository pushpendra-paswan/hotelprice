# Optional overrides; every variable has a default, so this file is not required.
# Copy to .env if you want to change them (.env is git-ignored). No secrets belong here.
# Note: the code reads os.environ only; it does not load .env files itself,
# so export the variables (e.g. `set -a; source .env; set +a`) before running.

# Dataset CSV (default: data/dataset.csv)
HOTELPRICE_DATA_PATH=data/dataset.csv
# Where the data pipeline saves its fitted preprocessor (default: artifacts/preprocessor.joblib)
HOTELPRICE_PREPROCESSOR_PATH=artifacts/preprocessor.joblib
# Where training saves model.json, preprocessor.joblib, metrics.json (default: models/)
HOTELPRICE_MODEL_DIR=models
# Fraction of rows held out for testing (default: 0.2)
HOTELPRICE_TEST_SIZE=0.2
# Seed for the split and the model (default: 42)
HOTELPRICE_RANDOM_SEED=42
# MLflow backend store (default: sqlite:///<repo>/mlflow.db). SQLite is needed for the Model Registry.
HOTELPRICE_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Where MLflow stores run artifacts such as the logged model (default: <repo>/mlartifacts)
HOTELPRICE_MLFLOW_ARTIFACT_DIR=mlartifacts
# MLflow experiment that training runs are logged to (default: hotel-price-prediction)
HOTELPRICE_MLFLOW_EXPERIMENT=hotel-price-prediction
# Model Registry name; each training run registers a new version under it (default: hotel-price-model)
HOTELPRICE_MLFLOW_MODEL_NAME=hotel-price-model
