.gitignore
.dvc
.dvcignore
*.dvc
dvc.yaml
dvc.lock
data/
models/
artifacts/
mlflow.db
mlruns/
mlartifacts/
bentoml/
.venv/
venv/
env/
tests/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.env.*
.vscode/
.idea/
*.md
Dockerfile
.dockerignore
pyproject.toml
config/
pipelines/
